{
  "functions": [
    {
      "source": "backend",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "backend/**",
      "scripts/**"
    ],
    "rewrites": [
      {
        "source": "/student",
        "destination": "/pages/student.html"
      },
      {
        "source": "/student.html",
        "destination": "/pages/student.html"
      },
      {
        "source": "/teacher",
        "destination": "/pages/teacher.html"
      },
      {
        "source": "/teacher.html",
        "destination": "/pages/teacher.html"
      },
      {
        "source": "/admin",
        "destination": "/pages/admin.html"
      },
      {
        "source": "/admin.html",
        "destination": "/pages/admin.html"
      },
      {
        "source": "/api/**",
        "function": "api"
      }
    ]
  }
}
